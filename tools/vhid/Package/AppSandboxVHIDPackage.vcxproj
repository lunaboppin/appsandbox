<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{49DC7492-B905-4DA3-BC03-3E84C115F4A0}</ProjectGuid>
    <RootNamespace>AppSandboxVHIDPackage</RootNamespace>
    <DriverType>Package</DriverType>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Utility</ConfigurationType>
    <SignMode>TestSign</SignMode>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <PropertyGroup>
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
    <AsbBinLeaf Condition="'$(Platform)' == 'ARM64'">$(Configuration)-ARM64</AsbBinLeaf>
    <AsbBinLeaf Condition="'$(Platform)' != 'ARM64'">$(Configuration)</AsbBinLeaf>
    <AsbDriverSource>$(SolutionDir)$(Platform)\$(Configuration)\AppSandboxVHID</AsbDriverSource>
    <AsbDriverDest>$(SolutionDir)bin\$(AsbBinLeaf)\drivers</AsbDriverDest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <DriverSign><FileDigestAlgorithm>sha256</FileDigestAlgorithm></DriverSign>
    <PostBuildEvent>
      <Command>if not exist "$(AsbDriverDest)\" mkdir "$(AsbDriverDest)\"
copy /Y "$(AsbDriverSource)\AppSandboxVHID.sys" "$(AsbDriverDest)\"
copy /Y "$(AsbDriverSource)\AppSandboxVHID.inf" "$(AsbDriverDest)\"
copy /Y "$(AsbDriverSource)\AppSandboxVHID.cat" "$(AsbDriverDest)\"
powershell -NoProfile -Command "$sig = Get-AuthenticodeSignature '$(AsbDriverSource)\AppSandboxVHID.cat'; if ($sig.SignerCertificate) { [IO.File]::WriteAllBytes('$(AsbDriverDest)\AppSandboxVHID.cer', $sig.SignerCertificate.RawData) }"</Command>
      <Message>Copying AppSandboxVHID driver package to $(AsbDriverDest)...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppSandboxVHID.vcxproj">
      <Project>{38CB6381-A8F4-4C92-AB92-2D73B004E3F9}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
