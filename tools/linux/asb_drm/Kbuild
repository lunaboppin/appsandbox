# AppSandbox virtual DRM driver — kernel-side build glue.
#
# Built as an out-of-tree module via DKMS; kernel headers must be installed.

obj-m := asb_drm.o

asb_drm-y := \
	asb_drm_drv.o \
	asb_drm_mode.o \
	asb_drm_connector.o \
	asb_drm_plane.o \
	asb_drm_writeback.o

ccflags-y := -Wall -Werror=implicit-function-declaration

# Linux 7.2 renamed struct drm_atomic_state, and which kernels have that depends
# on the distro's backports rather than the version number.
ccflags-y += $(shell grep -qs 'struct drm_atomic_commit' $(srctree)/include/drm/drm_atomic.h && echo -DASB_HAVE_DRM_ATOMIC_COMMIT)
